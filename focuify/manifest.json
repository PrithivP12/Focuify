{
  "manifest_version": 3,
  "name": "Focuify",
  "version": "1.5.0",
  "description": "A private, local-first extension that keeps browsing aligned with a focus goal.",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "permissions": ["storage", "webNavigation", "scripting", "offscreen"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Focuify",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    },
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116"
}
